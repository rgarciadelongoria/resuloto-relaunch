{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "resuloto-app": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "rl",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {},
          "configurations": {
            "production": { "target": "resuloto-app:esbuild:production" },
            "development": { "target": "resuloto-app:esbuild:development", "dev": true },
            "pages": { "target": "resuloto-app:esbuild:pages" }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "resuloto-app:esbuild:development",
            "rebuildDelay": 0,
            "dev": true,
            "port": 4201
          }
        },
        "esbuild": {
          "builder": "@angular-devkit/build-angular:browser-esbuild",
          "options": {
            "outputPath": "dist/resuloto-app",
            "index": "src/index.html",
            "polyfills": ["zone.js", "es-module-shims"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/assets"],
            "styles": ["src/styles.css"],
            "main": "src/main.ts"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all",
              "extractLicenses": true
            },
            "pages": {
              "optimization": true,
              "sourceMap": false,
              "outputHashing": "all",
              "extractLicenses": true,
              "baseHref": "/resuloto-relaunch/"
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false,
              "buildOptimizer": false,
              "vendorChunk": false,
              "namedChunks": false
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": { "analytics": false }
}
